#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ensemble_id="${ENSEMBLE_ID:-}"
input_root="${KFLOW_INPUT_DIR:-${INPUT_DIR:-/inputs}}"
output_root="${KFLOW_OUTPUT_DIR:-${OUTPUT_DIR:-/output}}"

if [[ ! "$ensemble_id" =~ ^ensemble-[0-9]{3}$ ]]; then
  printf 'ENSEMBLE_ID must have the form ensemble-NNN.\n' >&2
  exit 64
fi

model_output="$output_root/equilibrium-hessian/$ensemble_id"
cached_payload="$repo_dir/data/estimation/equilibrium-per-model/${ensemble_id}.rds"
if [[ -s "$cached_payload" ]]; then
  mkdir -p "$model_output"
  Rscript - "$cached_payload" "$ensemble_id" <<'RS'
args <- commandArgs(trailingOnly = TRUE)
payload <- readRDS(args[[1L]])
ensemble_id <- args[[2L]]
valid <- is.list(payload) &&
  identical(payload$metadata$ensemble_id[[1L]], ensemble_id) &&
  identical(payload$central$ensemble_id[[1L]], ensemble_id) &&
  payload$metadata$draws[[1L]] == 100L &&
  nrow(payload$draws) == 100L &&
  identical(payload$draws$draw, 1:100) &&
  all(payload$draws$ensemble_id == ensemble_id) &&
  all(is.finite(unlist(payload$draws[-(1:2)]))) &&
  all(unlist(payload$draws[-(1:2)]) > 0)
if (!isTRUE(valid)) stop("The committed equilibrium payload is invalid.")
RS
  cp "$cached_payload" "$model_output/${ensemble_id}.rds"
  (cd "$model_output" && sha256sum "${ensemble_id}.rds" > SHA256SUMS)
  printf '%s\n' success > "$model_output/status.txt"
  printf 'Reused checksum-locked equilibrium uncertainty for %s.\n' "$ensemble_id"
  exit 0
fi

source_dir="$(find "$input_root" -type d -path "*/outputs/models/${ensemble_id}" -print -quit)"
if [[ -z "$source_dir" ]]; then
  printf 'Could not find %s in the attached Hessian archive.\n' "$ensemble_id" >&2
  exit 66
fi

required=(
  final.par bet.frq bet.ini bet.tag bet.age_length bet.reg_scaling mfcl.cfg
  hessian/part_1/bet.hes
)
for path in "${required[@]}"; do
  if [[ ! -s "$source_dir/$path" ]]; then
    printf 'Attached Hessian archive is missing %s.\n' "$path" >&2
    exit 67
  fi
done

base_payload="$repo_dir/data/estimation/per-model/${ensemble_id}.rds"
test -s "$base_payload"
work_dir="$(mktemp -d)"
mkdir -p "$model_output"
preserve_diagnostics() {
  for stream in stdout stderr; do
    raw="$model_output/equilibrium-gradient.$stream"
    if [[ -s "$raw" ]]; then
      gzip -c "$raw" > "$raw.gz"
    fi
  done
  for diagnostic in bet.dep deplabel.tmp; do
    if [[ -s "$work_dir/$diagnostic" ]]; then
      gzip -c "$work_dir/$diagnostic" > "$model_output/$diagnostic.gz"
    fi
  done
  {
    for path in bet.dep deplabel.tmp bet.hes; do
      if [[ -e "$work_dir/$path" ]]; then
        stat -c '%n %s bytes' "$work_dir/$path"
      else
        printf '%s missing\n' "$work_dir/$path"
      fi
    done
  } > "$model_output/run-file-audit.txt"
}
cleanup() {
  cleanup_status=$?
  set +e
  if [[ "$cleanup_status" -ne 0 ]]; then
    preserve_diagnostics
  fi
  rm -rf -- "$work_dir"
  return "$cleanup_status"
}
trap cleanup EXIT

for path in final.par bet.frq bet.ini bet.tag bet.age_length bet.reg_scaling mfcl.cfg; do
  cp "$source_dir/$path" "$work_dir/${path##*/}"
done
cp "$source_dir/hessian/part_1/bet.hes" "$work_dir/bet.hes"
cp "$repo_dir/mfclo64" "$work_dir/mfclo64"
chmod +x "$work_dir/mfclo64"

set +e
(
  cd "$work_dir"
  ./mfclo64 bet.frq final.par hessian \
    -switch 4 1 145 2 1 37 2 1 229 1245 1 230 4000 \
    > "$model_output/equilibrium-gradient.stdout" \
    2> "$model_output/equilibrium-gradient.stderr"
)
model_status=$?
set -e
if [[ "$model_status" -ne 0 && "$model_status" -ne 1 ]]; then
  printf 'Equilibrium dependent-variable run failed with status %s.\n' \
    "$model_status" >&2
  exit "$model_status"
fi
for path in bet.dep deplabel.tmp bet.hes; do
  if [[ ! -s "$work_dir/$path" ]]; then
    printf 'Equilibrium calculation did not produce %s.\n' "$path" >&2
    exit 68
  fi
done

Rscript "$repo_dir/scripts/process-equilibrium-hessian-uncertainty.R" \
  "$work_dir" "$ensemble_id" \
  "$repo_dir/data/ensemble/management-quantities.csv" \
  "$base_payload" "$model_output/${ensemble_id}.rds" 100 \
  > "$model_output/processor.log" 2>&1

(cd "$model_output" && sha256sum "${ensemble_id}.rds" > SHA256SUMS)
printf '%s\n' success > "$model_output/status.txt"
printf 'Stored equilibrium-reference-point uncertainty for %s.\n' "$ensemble_id"
