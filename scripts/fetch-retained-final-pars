#!/bin/sh
set -eu

if [ "$#" -lt 1 ] || [ "$#" -gt 3 ]; then
  echo "Usage: ./scripts/fetch-retained-final-pars OUTPUT_DIR [SSH_HOST] [REMOTE_TASK_ROOT]" >&2
  exit 2
fi

output_dir=$1
ssh_host=${2:-kyuhank@suvofpsubmit.corp.spc.int}
remote_task=${3:-/home/kyuhank/KflowOutput/bet-2026-ensemble-tau}
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
manifest="$repo_dir/data/ensemble/retained-final-par-manifest.csv"
streamer="$repo_dir/scripts/stream-retained-final-pars.py"

case "$ssh_host" in
  *[!A-Za-z0-9_.@-]*|'')
    echo "Refusing an invalid SSH host." >&2
    exit 2
    ;;
esac
case "$remote_task" in
  /home/*/KflowOutput/bet-2026-ensemble-tau) ;;
  *)
    echo "Refusing an unexpected remote Kflow task path." >&2
    exit 2
    ;;
esac
if [ ! -f "$manifest" ] || [ ! -f "$streamer" ]; then
  echo "The retained-PAR manifest or read-only streamer is missing." >&2
  exit 2
fi
if [ -L "$output_dir" ]; then
  echo "Refusing a symbolic-link output directory: $output_dir" >&2
  exit 2
fi
if [ -e "$output_dir" ]; then
  if [ ! -d "$output_dir" ] || [ -n "$(find "$output_dir" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
    echo "OUTPUT_DIR must not exist or must be an empty real directory." >&2
    exit 2
  fi
else
  mkdir -m 700 -- "$output_dir"
fi
output_dir=$(CDPATH= cd -- "$output_dir" && pwd)

temporary_archive=$(mktemp "${TMPDIR:-/tmp}/bet-ensemble-retained-pars.XXXXXX.tar.gz")
cleanup()
{
  case "$temporary_archive" in
    "${TMPDIR:-/tmp}"/bet-ensemble-retained-pars.*.tar.gz)
      if [ -f "$temporary_archive" ] && [ ! -L "$temporary_archive" ]; then
        rm -- "$temporary_archive"
      fi
      ;;
    *)
      echo "Refusing unexpected temporary archive cleanup: $temporary_archive" >&2
      exit 3
      ;;
  esac
}
trap cleanup EXIT HUP INT TERM

encoded_manifest=$(base64 < "$manifest" | tr -d '\n')
echo "Maintainer-only read from $ssh_host:$remote_task (no remote writes)."
ssh -o BatchMode=yes -- "$ssh_host" \
  python3 - "$remote_task" "$encoded_manifest" \
  < "$streamer" > "$temporary_archive"

observed_members=$(tar -tzf "$temporary_archive" | LC_ALL=C sort)
expected_members=$(awk -F, 'NR > 1 { print $1 "/final.par" }' "$manifest" | LC_ALL=C sort)
if [ "$observed_members" != "$expected_members" ]; then
  echo "Downloaded archive member list differs from the 80-row manifest." >&2
  exit 4
fi
tar -xzf "$temporary_archive" --no-same-owner --no-same-permissions -C "$output_dir"
"$repo_dir/scripts/verify-retained-final-pars" "$output_dir" - 1 fast
echo "Recovered and fast-verified all 80 retained final PARs in $output_dir."
