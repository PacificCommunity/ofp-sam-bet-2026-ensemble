#!/usr/bin/env python3
"""Restore central outputs with the small preserved engine; refit in TunaFlow v2.5."""

import argparse
import csv
import hashlib
import json
import os
import platform
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys

from saved import Source


IMAGE = (
    "ghcr.io/pacificcommunity/tuna-flow:v2.5@"
    "sha256:c87f1f6d9d4f62dc447844b58afe35f96af175bf933cb6cffbbbe39a59172360"
)
SAVED_IMAGE = "sha256:898925450ab7ec3f99cb9d8427cc37d24097cc2fe9f0468d74f70aaf35daec3a"
MFCL_PATH = "/home/mfcl/mfclo64"
MFCL_SHA256 = "f5bc1e232a86e51f920bce7271d8e0930d0b160e4d18dc46de44078f0fa24cd0"
REPO = Path(__file__).resolve().parent.parent

# The hash check precedes preparation and every call to the fitting executable.
# Override the image entrypoint so it cannot perform a runtime update first.
CONTAINER_SCRIPT = r"""
set -eu
expected_sha256=$1
program_path=$2
model_id=$3
design_file=$4
pair_id=$5
mode=$6
final_par=$7
final_sha=$8
case "$(uname -m)" in
  x86_64) ;;
  *) echo "This historical runtime requires linux/amd64." >&2; exit 2 ;;
esac
if [ ! -x "$program_path" ]; then
  echo "Pinned MFCL executable is missing or not executable: $program_path" >&2
  exit 2
fi
observed_sha256=$(sha256sum "$program_path")
observed_sha256=${observed_sha256%% *}
if [ "$observed_sha256" != "$expected_sha256" ]; then
  echo "MFCL SHA-256 mismatch; fitting refused." >&2
  echo "Expected: $expected_sha256; observed: $observed_sha256" >&2
  exit 2
fi
printf 'Verified historical v2.5 image MFCL: %s\n' "$observed_sha256"
Rscript /workspace/rr-test/validate.R "$pair_id"
export ENSEMBLE_DESIGN_FILE="$design_file"
if [ "$mode" = "outputs-only" ]; then
  python3 /workspace/rr-test/saved.py restore "$model_id" /rerun-output/run
  exec python3 /workspace/rr-test/evaluate-final.py "$program_path" "$model_id" /rerun-output/run
fi
exec /workspace/rr-test/run-model "$model_id" /rerun-output/run
"""


def read_rows(relative):
    with (REPO / relative).open(newline="", encoding="utf-8") as stream:
        return list(csv.DictReader(stream))


def select_model(selector, anchor):
    if not re.fullmatch(r"rrtest-[0-9]{3}-rr1", selector):
        raise ValueError("selector must be an exact rrtest-NNN-rr1 ID in rr-test/model-draws.csv")
    matches = [row for row in read_rows("rr-test/model-draws.csv") if row["ensemble_id"] == selector]
    if len(matches) != 1:
        raise ValueError(f"selector is not a unique paired-design row: {selector}")
    row = matches[0]
    anchor_id = row["anchor_ensemble_id"]
    if (
        row["tag_reporting_flag2"] != "1"
        or row["tag_reporting"] != "exclusion"
        or row["pairing_version"] != "retained-rr0-paired-rerun-v1"
        or selector != anchor_id.replace("ensemble-", "rrtest-", 1) + "-rr1"
    ):
        raise ValueError("paired-design identity or RR1 contract is invalid")
    anchors = [row for row in read_rows("design/model-draws.csv") if row["ensemble_id"] == anchor_id]
    if len(anchors) != 1 or anchors[0]["tag_reporting_flag2"] != "0" or anchors[0]["tag_reporting"] != "inclusion":
        raise ValueError("paired row does not map to a unique RR0 anchor")
    for manifest in ("retained-final-par-manifest.csv", "retained-final-ini-manifest.csv"):
        retained = [row for row in read_rows((f"rr-test/reference/{manifest}" if manifest == "retained-final-ini-manifest.csv" else f"data/ensemble/{manifest}")) if row["ensemble_id"] == anchor_id]
        if len(retained) != 1:
            raise ValueError(f"RR0 anchor is not uniquely retained in {manifest}")
    return (anchor_id, "design/model-draws.csv") if anchor else (selector, "rr-test/model-draws.csv")


def docker_command(model_id, design_file, output_dir, pair_id, saved_runtime=False, outputs_only=False, final_par="", final_sha=""):
    return [
        "docker", "run", "--rm", "--platform", "linux/amd64",
        *(["--pull=never"] if saved_runtime else []),
        "--cpus", "2", "--memory", "8g", "--network", "none",
        "--user", f"{os.getuid()}:{os.getgid()}",
        "--mount", f"type=bind,source={REPO},target=/workspace,readonly",
        "--mount", f"type=bind,source={output_dir},target=/rerun-output",
        "--workdir", "/workspace",
        "--env", "TUNA_FLOW_RUNTIME_UPDATE=never",
        "--env", "BET_PHASE10_11_CONVERGENCE=-4",
        "--env", f"PROGRAM_PATH={MFCL_PATH}",
        "--entrypoint", "/bin/sh", SAVED_IMAGE if saved_runtime else IMAGE,
        "-c", CONTAINER_SCRIPT, "rr-paired-rerun", MFCL_SHA256, MFCL_PATH, model_id, design_file, pair_id,
        "outputs-only" if outputs_only else "refit", final_par, final_sha,
    ]


def main():
    parser = argparse.ArgumentParser(
        description="Regenerate central outputs on Linux, or refit in historical TunaFlow v2.5."
    )
    parser.add_argument("selector", help="exact paired ID, e.g. rrtest-001-rr1")
    parser.add_argument("--anchor", action="store_true", help="rerun the selected pair's original RR0 anchor instead")
    parser.add_argument("--outputs-only", action="store_true", help="regenerate central outputs from the saved final PAR with one function evaluation")
    parser.add_argument("--docker", action="store_true", help="use the historical image for outputs-only too")
    parser.add_argument("--mfcl", type=Path, help="Linux outputs-only: use this exact preserved F5 executable instead of downloading it")
    parser.add_argument("--saved-runtime", action="store_true", help="use the exact locally loaded saved image ID and refuse image pulls")
    parser.add_argument("--output-dir", type=Path, help="new output directory (default: outputs/rr-test-local/MODEL_ID)")
    parser.add_argument("--dry-run", action="store_true", help="validate selection and print command without running, downloading or writing files")
    args = parser.parse_args()
    try:
        model_id, design_file = select_model(args.selector, args.anchor)
    except (ValueError, KeyError, OSError) as error:
        parser.error(str(error))
    final_par, final_sha, saved = "", "", None
    if args.outputs_only:
        try:
            saved = Source(REPO)
            entry = saved.model(model_id)["final_par"]
            saved.read(entry)
            saved.input_hashes(model_id)
        except (ValueError, OSError, KeyError) as error:
            parser.error(str(error))
        final_par = entry.get("path", entry.get("member"))
        final_sha = entry["sha256"]
    native = args.outputs_only and not (args.docker or args.saved_runtime)
    if args.mfcl and not native:
        parser.error("--mfcl selects the Linux outputs-only path")
    default_root = "rr-test-evaluated" if args.outputs_only else "rr-test-local"
    requested_output = args.output_dir or REPO / "outputs" / default_root / model_id
    # Reject dangling symlinks too; resolving them first could hide an existing path.
    if os.path.lexists(requested_output):
        parser.error(f"output directory already exists; refusing reuse: {requested_output}")
    output_dir = requested_output.resolve()
    if output_dir == REPO or REPO in output_dir.parents and not (REPO / "outputs") in output_dir.parents:
        parser.error("output inside the checkout must be beneath outputs/")
    if any("," in str(path) or "\n" in str(path) for path in (REPO, output_dir)):
        parser.error("Docker bind paths must not contain commas or newlines")
    if native:
        print(f"Model: {model_id}; saved native inputs; one function evaluation", flush=True)
        print(f"Run files: {output_dir}", flush=True)
        if args.dry_run:
            print("Pinned MFCL source:", json.dumps(saved.recipe["engine"], sort_keys=True))
            print("Saved PAR:", final_par, final_sha)
            print("Native command: mfclo64 bet.frq input.par evaluated.par -file -")
            return 0
        if not sys.platform.startswith("linux") or platform.machine() not in ("x86_64", "AMD64"):
            parser.error("The small native executable requires Linux x86_64; use --docker for emulation")
        files = saved.native_files(model_id)
        engine = saved.recipe["engine"]
        try:
            if args.mfcl:
                with saved.tool.frozen_bytes(args.mfcl) as data:
                    program = saved.tool.checked(data, engine)
            else:
                program = saved.tool.git_bytes(engine)
            files["mfclo64"] = (program, 0o755)
            saved.tool.save_files(output_dir, files, model_id)
            from importlib.util import spec_from_file_location, module_from_spec
            spec = spec_from_file_location("saved_evaluation", REPO/"rr-test/evaluate-final.py")
            evaluation = module_from_spec(spec);spec.loader.exec_module(evaluation)
            evaluation.evaluate(output_dir/"mfclo64",output_dir/"final.par",final_sha,output_dir,model_id,saved)
        except (ValueError,OSError,KeyError,subprocess.CalledProcessError) as error:
            parser.error(str(error))
        return 0
    image = SAVED_IMAGE if args.saved_runtime else IMAGE
    command = docker_command(model_id, design_file, output_dir, args.selector, args.saved_runtime, args.outputs_only, final_par, final_sha)
    print(f"Model: {model_id}; historical image: TunaFlow v2.5", flush=True)
    print(f"Run files: {output_dir / 'run'}", flush=True)
    if args.dry_run:
        print(shlex.join(command))
        return 0
    if shutil.which("docker") is None:
        parser.error("Docker CLI is required")
    # Reserve exclusively before Docker. Failed attempts retain their log and
    # directory, and a later invocation must choose another output directory.
    try:
        output_dir.mkdir(parents=True, exist_ok=False)
    except OSError as error:
        parser.error(f"cannot reserve new output directory: {error}")
    receipt = {
        "schema_version": 1,
        "selector": args.selector,
        "model_id": model_id,
        "arm": "RR0" if args.anchor else "RR1",
        "design_file": design_file,
        "mode": "outputs-only" if args.outputs_only else "refit",
        "saved_final_par": final_par or None,
        "saved_final_par_sha256": final_sha or None,
        "docker_image": image,
        "platform": "linux/amd64",
        "mfcl_path": MFCL_PATH,
        "mfcl_sha256_required": MFCL_SHA256,
        "TUNA_FLOW_RUNTIME_UPDATE": "never",
        "BET_PHASE10_11_CONVERGENCE": "-4",
        "argv": command,
        "status": "starting",
    }
    receipt_path = output_dir / "rerun-command.json"
    receipt_path.write_text(json.dumps(receipt, indent=2) + "\n", encoding="utf-8")
    try:
        with (output_dir / "rerun.log").open("w", encoding="utf-8") as log:
            process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            for line in process.stdout:
                log.write(line)
                log.flush()
                sys.stdout.write(line)
                sys.stdout.flush()
            return_code = process.wait()
    except (OSError, KeyboardInterrupt) as error:
        receipt.update(status="interrupted_or_failed", error=str(error))
        receipt_path.write_text(json.dumps(receipt, indent=2) + "\n", encoding="utf-8")
        raise
    receipt.update(status="completed" if return_code == 0 else "failed", docker_exit_code=return_code)
    receipt_path.write_text(json.dumps(receipt, indent=2) + "\n", encoding="utf-8")
    return return_code


if __name__ == "__main__":
    sys.exit(main())
