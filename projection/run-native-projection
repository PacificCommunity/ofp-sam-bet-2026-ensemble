#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
work_dir="${1:-${repo_dir}/projection/work}"
input_dir="${MODEL_INPUT_DIR:-${repo_dir}/model}"
default_final_par="${input_dir}/final.par"
if [[ ! -s "$default_final_par" ]]; then
  default_final_par="${repo_dir}/../ofp-sam-bet-2026-diagnostic/results/reference/final.par"
fi
final_par="${2:-${default_final_par}}"
nsims="${NSIMS:-10}"
nyears="${NYEARS:-30}"
seed="${RECRUITMENT_SEED:-20260806}"

mkdir -p "$work_dir"

Rscript "$repo_dir/projection/prepare-native-projection.R" \
  "--input-dir=${input_dir}" \
  "--final-par=${final_par}" \
  "--output-dir=${work_dir}" \
  "--nyears=${nyears}" \
  "--nsims=${nsims}" \
  "--seed=${seed}" \
  "--average-years=2022,2023,2024"

cd "$work_dir"
chmod +x ./mfclo64

./mfclo64 proj.frq proj.ini 00.par -makepar > makepar.stdout 2> makepar.stderr
test -s 00.par

Rscript "$repo_dir/projection/configure-native-par.R" \
  "$final_par" 00.par proj.frq "$work_dir" "$nsims" "$seed"

run_stage() {
  local label="$1"
  shift
  set +e
  ./mfclo64 "$@" > "${label}.stdout" 2> "${label}.stderr"
  local status=$?
  set -e
  if [[ "$status" -ne 0 && "$status" -ne 1 ]]; then
    printf '%s failed with status %s\n' "$label" "$status" >&2
    return "$status"
  fi
}

# Native stochastic setup writes the fished and no-fishing projection
# parameter files in one option-7 pass.  Keeping the switches on the command
# line matches the verified mfclkit native self-test pathway exactly.
run_stage option7 proj.frq proj.par option7.par \
  -switch 2 1 145 7 2 20 "$nsims"
test -s proj.dep
test -s proparams.val
test -s proparams_noeff.val
grep -q 'Finished dep_gradients_calc2' option7.stdout

run_stage option8 proj.frq proj.par option8.par \
  -switch 5 1 145 8 1 234 1 1 235 20 1 237 0 2 20 "$nsims"
test -s simyears
test -s simulated_numbers_at_age
test -s simulated_numbers_at_age_noeff

# The assessment program rewrites catch.rep and its plot report for every
# stochastic replicate.  Preserve those already-computed values so annual
# catch biomass can be divided by the matching model-computed MSY.  This is
# necessary because the projection fisheries retain a mixture of number and
# weight input units and those raw inputs cannot be summed scientifically.
diagnostic_dir="$work_dir/projection-diagnostics"
mkdir -p "$diagnostic_dir"
initial_catch_hash=""
diagnostic_watcher_pid=""
stop_diagnostic_watcher() {
  if [[ -n "$diagnostic_watcher_pid" ]] && kill -0 "$diagnostic_watcher_pid" 2>/dev/null; then
    kill "$diagnostic_watcher_pid"
    wait "$diagnostic_watcher_pid" 2>/dev/null || true
  fi
}
trap stop_diagnostic_watcher EXIT
if [[ -s catch.rep ]]; then
  initial_catch_hash="$(sha256sum catch.rep | awk '{print $1}')"
fi
(
  set -euo pipefail
  captured=0
  previous_catch_hash="$initial_catch_hash"
  while [[ "$captured" -lt "$nsims" ]]; do
    available=0
    if [[ -s Fmults.txt ]]; then
      available="$(grep -c '^#simulation [0-9]' Fmults.txt || true)"
    fi
    if [[ "$available" -gt "$captured" ]]; then
      simulation="$((captured + 1))"
      suffix="$(printf '%02d' "$simulation")"
      report_file="plot-projection.par.rep"
      for attempt in $(seq 1 6000); do
        if [[ -s "$report_file" ]] && grep -q '^# MSY$' "$report_file"; then
          cp "$report_file" "$diagnostic_dir/plot-simulation-${suffix}.rep"
          break
        fi
        sleep 0.1
      done
      test -s "$diagnostic_dir/plot-simulation-${suffix}.rep"

      for attempt in $(seq 1 6000); do
        if [[ -s catch.rep ]]; then
          catch_hash="$(sha256sum catch.rep | awk '{print $1}')"
          if [[ "$catch_hash" != "$previous_catch_hash" ]]; then
            cp catch.rep "$diagnostic_dir/catch-simulation-${suffix}.rep"
            previous_catch_hash="$catch_hash"
            break
          fi
        fi
        sleep 0.1
      done
      test -s "$diagnostic_dir/catch-simulation-${suffix}.rep"
      captured="$simulation"
    else
      sleep 0.1
    fi
  done
) &
diagnostic_watcher_pid=$!

# Native stochastic projection.  Only recruitment is stochastic here:
# catch is held at the 2022--2024 mean, and effort/catch randomisation flags
# 234 and 237 remain off.  The switches follow the MFCL projection workflow.
run_stage projection proj.frq proj.par projection.par \
  -switch 7 \
    1 1 1 \
    -999 55 1 \
    2 20 "$nsims" \
    1 145 0 \
    1 234 0 \
    1 235 20 \
    1 237 0

wait "$diagnostic_watcher_pid"
diagnostic_watcher_pid=""
Rscript "$repo_dir/projection/parse-catch-msy.R" \
  "$work_dir" "$nsims" "$work_dir/projection-catch-msy.csv"

for output in \
  projected_numbers_at_age projected_numbers_at_age_noeff \
  projected_spawning_biomass projected_spawning_biomass_noeff \
  projected_fmort_at_age_year Fmults.txt projection-catch-msy.csv \
  historical-regional-spawning-biomass.csv; do
  test -s "$output"
done

sha256sum \
  proj.frq proj.par proj7-fished.par proj7-noeff.par proj8.par simyears \
  simulated_numbers_at_age simulated_numbers_at_age_noeff \
  projected_spawning_biomass projected_spawning_biomass_noeff Fmults.txt \
  projection-catch-msy.csv historical-regional-spawning-biomass.csv \
  > native-projection-SHA256SUMS

printf 'Assessment-model projection completed: %s simulations, %s years.\n' \
  "$nsims" "$nyears"
